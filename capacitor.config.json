{
  "appId": "com.noyau.app",
  "appName": "Noyau",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://noyau.lan:4242",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "noyau.lan",
      "localhost"
    ]
  },
  "plugins": {
    "CapacitorHttp": { "enabled": true },
    "CapacitorCookies": { "enabled": true },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0d1117"
    }
  }
}
