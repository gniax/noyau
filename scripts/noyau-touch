#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
app_root=$(dirname -- "$script_dir")
profile_root="${HOME}/snap/firefox/common/noyau-touch-profile"
legacy_profile="${XDG_DATA_HOME:-${HOME}/.local/share}/noyau-touch/firefox"
app_url="${NOYAU_TOUCH_URL:-http://127.0.0.1:4242/?touch=1}"
runtime_root="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
launch_lock="$runtime_root/noyau-touch-launch.lock"

if [ -z "${DISPLAY:-}" ]; then
  DISPLAY=$(systemctl --user show-environment | sed -n 's/^DISPLAY=//p' | head -n 1)
  export DISPLAY
fi
if [ -z "${XAUTHORITY:-}" ]; then
  XAUTHORITY=$(systemctl --user show-environment | sed -n 's/^XAUTHORITY=//p' | head -n 1)
  export XAUTHORITY
fi
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
  DBUS_SESSION_BUS_ADDRESS=$(systemctl --user show-environment | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -n 1)
  export DBUS_SESSION_BUS_ADDRESS
fi

exec 9>"$launch_lock"
flock -n 9 || exit 0

mkdir -p "$profile_root"
install -m 600 "$app_root/desktop/firefox-user.js" "$profile_root/user.js"
systemctl --user start noyau.service

profile_pids=""
for candidate in $(pgrep -u "$(id -u)" -x firefox 2>/dev/null || true); do
  executable=$(readlink "/proc/$candidate/exe" 2>/dev/null || true)
  arguments=$(tr '\0' ' ' < "/proc/$candidate/cmdline" 2>/dev/null || true)
  case "$executable:$arguments" in
    */firefox:*" --profile $profile_root "*|*/firefox:*" --profile $legacy_profile "*) profile_pids="$profile_pids $candidate" ;;
  esac
done
if [ -n "$profile_pids" ]; then
  profile_running() {
    for pid in $profile_pids; do
      if kill -0 "$pid" 2>/dev/null; then return 0; fi
    done
    return 1
  }
  for pid in $profile_pids; do
    kill -TERM "$pid" 2>/dev/null || true
  done
  attempt=0
  while [ "$attempt" -lt 30 ] && profile_running; do
    attempt=$((attempt + 1))
    sleep 0.1
  done
  if profile_running; then
    for pid in $profile_pids; do
      kill -KILL "$pid" 2>/dev/null || true
    done
    sleep 0.3
  fi
  if profile_running; then
    notify-send "Noyau Desk" "Instance Noyau impossible à arrêter"
    exit 1
  fi
fi

case "$profile_root" in
  */snap/firefox/common/noyau-touch-profile) rm -f "$profile_root/.parentlock" "$profile_root/lock" "$profile_root/parent.lock" ;;
  *) notify-send "Noyau Desk" "Profil Firefox invalide; relance annulée"; exit 1 ;;
esac

attempt=0
server_ready=false
while [ "$attempt" -lt 40 ]; do
  if curl --fail --silent --output /dev/null http://127.0.0.1:4242/version.json; then
    server_ready=true
    break
  fi
  attempt=$((attempt + 1))
  sleep 0.25
done

if [ "$server_ready" != true ]; then
  notify-send "Noyau Desk" "Serveur Noyau indisponible; Firefox non lancé"
  exit 1
fi

if [ -z "${DISPLAY:-}" ]; then
  notify-send "Noyau Desk" "Session graphique indisponible"
  exit 1
fi

/usr/bin/firefox --new-instance --profile "$profile_root" --kiosk "$app_url" &
firefox_launcher=$!
sleep 2
flock -u 9
wait "$firefox_launcher"
